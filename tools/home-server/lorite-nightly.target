# Canonical copy: ~/git/dotfiles/tools/home-server/lorite-nightly.target
# The server's nightly batch: one 01:00 activation (lorite-nightly.timer) pulls in all
# five jobs, and After= lines inside the services run them in strict sequence with no
# gaps and no overlap: ha-to-aw -> aw-daily-export -> dotfiles-pull -> vault-git-backup
# -> morning briefing. vault-git-backup is ordered before the briefing so the briefing's
# git audit reads commits that already exist. It was added 2026-08-12 to replace the
# obsidian-git plugin, which used to commit the vault as a side effect of the hourly
# headless-Obsidian run, into a local-only repo with no remote.
# After= only orders (it does not propagate failure), so a failed job never blocks the
# rest, and each keeps its own journalctl history. The first two services live in
# ~/git/lorite-activitywatch/systemd/; Wants= tolerates their absence on other hosts.
# StopWhenUnneeded lets the target deactivate once the jobs finish, so the next
# night's timer activation re-runs the whole batch.
[Unit]
Description=Nightly server batch: HA import, AW export, dotfiles pull, vault git backup, morning briefing
Wants=ha-to-aw.service aw-daily-export.service dotfiles-pull.service vault-git-backup.service lorite-morning-briefing.service
StopWhenUnneeded=true
