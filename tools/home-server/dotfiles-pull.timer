# Canonical copy: ~/git/dotfiles/tools/home-server/dotfiles-pull.timer
# Standalone fallback only, NOT enabled on the server: since 2026-07-31 the service is
# pulled in by lorite-nightly.target (01:00 batch, third slot, After=aw-daily-export),
# so this timer stays disabled there. Persistent catches nights the host was off.
[Unit]
Description=Daily dotfiles fast-forward pull (standalone fallback)

[Timer]
OnCalendar=*-*-* 01:30:00
Persistent=true
Unit=dotfiles-pull.service

[Install]
WantedBy=timers.target
