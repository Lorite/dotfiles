# Canonical copy: ~/git/dotfiles/tools/home-server/dotfiles-pull.timer
# Daily at 01:30, before the 01:45 morning briefing on this host, so briefing and early phone
# sessions load the freshest CLAUDE.md and skills. Persistent catches nights the server was off.
[Unit]
Description=Daily 01:30 dotfiles fast-forward pull

[Timer]
OnCalendar=*-*-* 01:30:00
Persistent=true
Unit=dotfiles-pull.service

[Install]
WantedBy=timers.target
