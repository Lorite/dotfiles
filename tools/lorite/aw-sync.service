# Canonical copy: ~/git/dotfiles/tools/lorite/aw-sync.service
# Installed to ~/.config/systemd/user/ by install.sh.
# Runs aw-sync (from the ActivityWatch rust bundle) as a daemon: every 5 min it
# writes this laptop's buckets into ~/ActivityWatchSync/<device-uuid>/ and pulls
# any other device's buckets present there. That directory is replicated to the
# home server by Syncthing (same mechanism as the vault) — so aw-server is never
# exposed over the network. The home server runs aw-server-rust + its own aw-sync
# to import the laptop's data. See the "Use ActivityWatch..." task note, Phase 2.
[Unit]
Description=ActivityWatch aw-sync daemon (sync buckets to the Syncthing sync dir)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/opt/activitywatch/aw-server-rust/aw-sync --port 5600 daemon
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
