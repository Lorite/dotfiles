# Canonical copy: ~/git/dotfiles/tools/lorite/lorite-weekly-note.service
# Installed to ~/.config/systemd/user/ by install.sh. Paired with the .timer.
[Unit]
Description=Weekly note: create + fill diary/weekly for the last completed week (headless LLM)
# Ordering only: when the Monday 03:00 firing overlaps a still-running nightly batch,
# wait for the briefing so Sunday's daily summary exists first. Harmless elsewhere.
After=lorite-morning-briefing.service

[Service]
Type=oneshot
ExecStart=%h/git/dotfiles/tools/lorite/weekly_note.sh
Environment=PATH=%h/.local/bin:%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin
# Same client pinning rationale as the morning briefing: the roll-up distills a week
# of notes and the drafted reflections go in front of the user every Monday, so pin the
# strongest available client and accept the lorite-llm fallback down the chain on failure.
# FLIPPED TO ANTIGRAVITY 2026-09-16 at the user's explicit request, alongside the briefing.
# No security-audit caveat applies here (this job writes reflections, it does not audit
# commits), so this flip carries none of the briefing's measurement risk.
Environment=LLM_CLIENT=antigravity
EnvironmentFile=-%h/.config/lorite/morning-briefing.env
TimeoutStartSec=30min
