[Unit]
Description=Capture substantially-watched YouTube videos from ActivityWatch into the Obsidian inbox
# Discovery only. The stubs it writes are enriched into full notes by
# obsidian-inbox-watcher.timer, which already runs every 2 minutes.
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/git/dotfiles/tools/lorite/obsidian-clipper/aw-youtube-capture.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
