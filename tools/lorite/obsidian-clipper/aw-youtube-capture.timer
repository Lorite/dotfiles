[Unit]
Description=Look for newly-watched YouTube videos every 6 hours

[Timer]
# The script's default look-back is 2 days and it dedups against existing notes and
# stubs, so the cadence only controls latency, never duplicates. Six hours keeps a
# video reaching the vault the same day without querying ActivityWatch constantly.
OnBootSec=15min
OnUnitActiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
