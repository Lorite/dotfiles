# Canonical copy: ~/git/dotfiles/tools/lorite/aw-media-to-stt.timer
# Every 5 minutes while logged in. The bridge only forwards sessions that have
# clearly ended (idle > SETTLE), so a 5-min cadence gives near-real-time entries
# without waiting for midnight — the old batch-sync latency this replaces.
[Unit]
Description=Every 5 min: forward ActivityWatch media playback to SimpleTimeTracker

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
Unit=aw-media-to-stt.service

[Install]
WantedBy=timers.target
