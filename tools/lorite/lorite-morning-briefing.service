# Canonical copy: ~/git/dotfiles/tools/lorite/lorite-morning-briefing.service
# Installed to ~/.config/systemd/user/ by install.sh. Paired with the .timer.
[Unit]
Description=Morning briefing: daily-note LLM summaries + vault git audit (headless Claude Code)
# Ordering only, for the server's lorite-nightly.target batch: run last, after the
# dotfiles pull, so the briefing loads fresh skills. Ignored on the laptop (the pull
# unit is not queued there) and harmless for standalone runs.
After=dotfiles-pull.service

[Service]
Type=oneshot
ExecStart=%h/git/dotfiles/tools/lorite/morning_briefing.sh
Environment=PATH=%h/.local/bin:%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin
# Pin Claude for THIS job, against lorite-llm's OpenCode-first default.
#
# Measured 2026-07-25, both clients over the same commit (1818999) on the same day:
#   Claude   — found live Google OAuth accessToken + refreshToken committed in
#              .obsidian/plugins/tasknotes/data.json, with remediation steps
#   OpenCode — "✅ No issues found"   (opencode/deepseek-v4-flash-free)
#
# The briefing's git audit is a security review, and a false "no issues" is worse than
# no briefing at all. This is not a claim that OpenCode is unfit generally — it did the
# briefing BACKFILL well on the same free model. Re-measure once OpenCode Go's paid
# models (GLM-5.2 / Kimi K2.7 Code) are wired, and drop this line if they pass.
Environment=LLM_CLIENT=claude
# Host-specific overrides (optional; '-' = ok if absent). The home server writes
# LORITE_VAULT_GIT=%h/git/lorite-obsidian-notes-audit here (the side clone used for
# the commit audit, since Syncthing excludes .git/). Laptop has no file → defaults.
EnvironmentFile=-%h/.config/lorite/morning-briefing.env
TimeoutStartSec=30min
# Already-written today → quick exit 0; failures show in `journalctl --user -u lorite-morning-briefing`
