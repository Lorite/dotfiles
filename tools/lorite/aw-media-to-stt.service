# Canonical copy: ~/git/dotfiles/tools/lorite/aw-media-to-stt.service
# Installed to ~/.config/systemd/user/ by install.sh. Paired with the .timer.
# Forwards ActivityWatch media playback (aw-watcher-media-player) to
# SimpleTimeTracker via simple_time_tracker.py. Ad-title flips inside a video
# are merged into one session. Replaces the media half of linux-simple-app-logger.
[Unit]
Description=Forward ActivityWatch media playback to SimpleTimeTracker

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/git/dotfiles/tools/lorite/aw_media_to_stt.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# simple_time_tracker.py reads the Automate secret from <vault>/.secrets/automate.env
EnvironmentFile=-%h/.config/lorite/morning-briefing.env
TimeoutStartSec=1min
# aw-server down / no media → exits 0 quietly; failures in
# `journalctl --user -u aw-media-to-stt`
