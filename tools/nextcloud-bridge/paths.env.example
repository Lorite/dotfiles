# ~/.config/dotfiles/paths.env — per-machine paths for the dotfiles install.
#
# Copy to ~/.config/dotfiles/paths.env and edit for this machine. Sourced by
# tools/nextcloud-bridge/setup-bridge.sh (and, indirectly, install.sh). All values
# are optional; the commented defaults below are what the laptop already uses.

# Nextcloud SYNC-CLIENT root (real local files, offline-available). Do NOT point
# this at a WebDAV mount (e.g. ~/nextcloud-all): WebDAV is slow, breaks offline,
# and can serve stale cache — bad for Obsidian's indexer and for agents/scripts
# that read files non-interactively.
# NEXTCLOUD_BASE="$HOME/nextcloud"

# Obsidian vault (the Syncthing-synced note repo).
# OBSIDIAN_VAULT="$HOME/git/lorite-obsidian-notes"

# Which Nextcloud subfolders to expose in the vault, as space/newline-separated
# "subfolder:linkname" pairs. Each becomes  vault/<linkname> -> NEXTCLOUD_BASE/<subfolder>,
# embeddable as  ![[<linkname>/file.pdf]]  and ignored by Syncthing + git (so every
# machine creates its own link locally — targets and /home/<user> differ per host).
# Bridge only curated subfolders, never the whole Nextcloud tree.
# NEXTCLOUD_BRIDGE="zotero:papers documents:files"
