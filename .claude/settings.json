{
  "sandbox": {
    "enabled": false,
    "network": {
      "allowedDomains": [
        "api.semanticscholar.org",
        "api.openalex.org",
        "api.crossref.org",
        "export.arxiv.org",
        "api.unpaywall.org",
        "doi.org",
        "*.oclc.org",
        "github.com",
        "api.github.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/git/lorite-obsidian-notes",
        "~/git/lorite_ros2_humble_phd",
        "~/git/Drone-localization-support-from-a-quadruped-robot-CLAWAR-2026-",
        "~/.config/paper-scout"
      ]
    },
    "excludedCommands": [
      "docker *",
      "devcontainer *"
    ]
  },
  "effortLevel": "high",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
